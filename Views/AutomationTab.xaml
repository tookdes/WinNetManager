<UserControl x:Class="WinNetManager.Views.AutomationTab"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <Style x:Key="ToolbarButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Padding" Value="10,4"/>
            <Setter Property="Margin" Value="0,0,6,6"/>
            <Setter Property="MinHeight" Value="26"/>
        </Style>
        <Style x:Key="SectionLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style x:Key="EllipsisCell" TargetType="TextBlock">
            <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
    </UserControl.Resources>

    <DockPanel Margin="8,8,8,6">
        <Border DockPanel.Dock="Top" Margin="0,0,0,8" Padding="10,8"
                Background="{DynamicResource PanelBgBrush}"
                BorderBrush="{DynamicResource BorderLineBrush}"
                BorderThickness="1" CornerRadius="3">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="16"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <ToggleButton x:Name="TglGlobal" Content="启用自动化" Padding="14,5"
                                  FontWeight="SemiBold" MinWidth="96"
                                  Checked="TglGlobal_Checked" Unchecked="TglGlobal_Unchecked"
                                  ToolTip="全局总开关（默认关闭）。开启后才会按规则定时评估与执行动作"/>
                    <Border Margin="10,0,0,0" Padding="10,4" CornerRadius="3"
                            Background="{DynamicResource HeaderBgBrush}"
                            VerticalAlignment="Center">
                        <TextBlock x:Name="TbkEngineState" Text="引擎未运行" FontSize="12"
                                   Foreground="{DynamicResource SecondaryTextBrush}"/>
                    </Border>
                </StackPanel>
                <TextBlock Grid.Column="2" VerticalAlignment="Center" FontSize="11"
                           Foreground="{DynamicResource SecondaryTextBrush}"
                            TextWrapping="Wrap" Text="后台引擎开启且规则为“启用 + 自动”时，条件满足并达到门槛后才会执行动作；“仅评估”不会执行，需验证动作请点“测试动作”。"/>
            </Grid>
        </Border>

        <WrapPanel DockPanel.Dock="Top" Margin="0,0,0,2">
            <Button Style="{StaticResource ToolbarButton}" Content="从模板新建" Click="BtnTemplate_Click"
                    ToolTip="按 4 个内置场景生成规则（默认 dry-run + 禁用）"/>
            <Button Style="{StaticResource ToolbarButton}" Content="新建" Click="BtnNew_Click"/>
            <Rectangle Width="1" Height="16" Fill="{DynamicResource SeparatorBrush}" Margin="2,6,8,6" VerticalAlignment="Center"/>
            <Button Style="{StaticResource ToolbarButton}" Content="编辑" Click="BtnEdit_Click"/>
            <Button Style="{StaticResource ToolbarButton}" Content="启用/禁用" Click="BtnToggleEnabled_Click"/>
            <Button Style="{StaticResource ToolbarButton}" Content="删除" Click="BtnDelete_Click"
                    Foreground="{DynamicResource DangerBrush}"/>
            <Rectangle Width="1" Height="16" Fill="{DynamicResource SeparatorBrush}" Margin="2,6,8,6" VerticalAlignment="Center"/>
            <Button Style="{StaticResource ToolbarButton}" Content="仅评估" Click="BtnEvaluate_Click"
                    ToolTip="只评估当前条件是否满足，不执行任何动作"/>
            <Button Style="{StaticResource ToolbarButton}" Content="测试动作" Click="BtnEvaluateAndTrigger_Click"
                    ToolTip="立即读取当前快照并按安全策略触发动作；仍受全局开关、dry-run、冷却、预算和重新武装约束"/>
            <Button Style="{StaticResource ToolbarButton}" Content="重置状态" Click="BtnResetState_Click"
                    ToolTip="清除连续计数、冷却和等待恢复状态；修改执行模式后可用"/>
            <Button Style="{StaticResource ToolbarButton}" Content="清除触发计数" Click="BtnResetBudget_Click"
                    ToolTip="把选中规则的本小时/本日触发计数清零（达到预算上限后会暂停该规则）"/>
            <Rectangle Width="1" Height="16" Fill="{DynamicResource SeparatorBrush}" Margin="2,6,8,6" VerticalAlignment="Center"/>
            <Button Style="{StaticResource ToolbarButton}" Content="导入" Click="BtnImport_Click"/>
            <Button Style="{StaticResource ToolbarButton}" Content="导出" Click="BtnExport_Click"/>
        </WrapPanel>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="2.2*" MinHeight="168"/>
                <RowDefinition Height="6"/>
                <RowDefinition Height="*" MinHeight="128"/>
            </Grid.RowDefinitions>

            <DockPanel Grid.Row="0">
                <DockPanel DockPanel.Dock="Top" Margin="0,2,0,6">
                    <TextBlock Style="{StaticResource SectionLabel}" Text="规则"/>
                    <TextBlock DockPanel.Dock="Right" HorizontalAlignment="Right" FontSize="11"
                               Foreground="{DynamicResource SecondaryTextBrush}" Text="双击编辑；右键可快捷操作"/>
                </DockPanel>
                <Grid>
                    <DataGrid x:Name="RuleGrid" AutoGenerateColumns="False" CanUserAddRows="False"
                              IsReadOnly="True" SelectionMode="Single" GridLinesVisibility="Horizontal"
                              HeadersVisibility="Column" ColumnWidth="Auto"
                              MouseDoubleClick="RuleGrid_MouseDoubleClick">
                        <DataGrid.ContextMenu>
                            <ContextMenu>
                                <MenuItem Header="编辑" Click="BtnEdit_Click"/>
                                <MenuItem Header="启用/禁用" Click="BtnToggleEnabled_Click"/>
                                <MenuItem Header="仅评估" Click="BtnEvaluate_Click"/>
                                <MenuItem Header="测试动作" Click="BtnEvaluateAndTrigger_Click"/>
                                <MenuItem Header="重置状态" Click="BtnResetState_Click"/>
                                <MenuItem Header="清除触发计数" Click="BtnResetBudget_Click"/>
                                <Separator/>
                                <MenuItem Header="删除" Click="BtnDelete_Click"
                                          Foreground="{DynamicResource DangerBrush}"/>
                            </ContextMenu>
                        </DataGrid.ContextMenu>
                        <DataGrid.Columns>
                            <DataGridTextColumn Binding="{Binding Name}" Header="名称" Width="140"
                                                ElementStyle="{StaticResource EllipsisCell}"/>
                            <DataGridTextColumn Binding="{Binding ModeText}" Header="模式" Width="52"/>
                            <DataGridTextColumn Binding="{Binding StatusText}" Header="状态" Width="78">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock" BasedOn="{StaticResource EllipsisCell}">
                                        <Setter Property="Foreground" Value="{DynamicResource SecondaryTextBrush}"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding StatusBrushKey}" Value="Danger">
                                                <Setter Property="Foreground" Value="{DynamicResource DangerBrush}"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding StatusBrushKey}" Value="Warn">
                                                <Setter Property="Foreground" Value="{DynamicResource WarningTextBrush}"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding StatusBrushKey}" Value="Ok">
                                                <Setter Property="Foreground" Value="{DynamicResource SuccessTextBrush}"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <DataGridTextColumn Binding="{Binding ConditionSummary}" Header="条件" Width="*"
                                                ElementStyle="{StaticResource EllipsisCell}"/>
                            <DataGridTextColumn Binding="{Binding ActionsSummary}" Header="动作" Width="*"
                                                ElementStyle="{StaticResource EllipsisCell}"/>
                            <DataGridTextColumn Binding="{Binding IntervalMinutes}" Width="48">
                                <DataGridTextColumn.Header>
                                    <TextBlock Text="间隔" ToolTip="评估间隔（分钟）"/>
                                </DataGridTextColumn.Header>
                            </DataGridTextColumn>
                            <DataGridTextColumn Binding="{Binding ConsecutiveMatches}" Width="44">
                                <DataGridTextColumn.Header>
                                    <TextBlock Text="连续" ToolTip="连续满足次数"/>
                                </DataGridTextColumn.Header>
                            </DataGridTextColumn>
                            <DataGridTextColumn Binding="{Binding LastEvaluated}" Header="上次评估" Width="102"/>
                            <DataGridTextColumn Binding="{Binding LastTrigger}" Header="上次触发" Width="102"/>
                            <DataGridTextColumn Binding="{Binding TodayCount}" Header="今日" Width="44"/>
                        </DataGrid.Columns>
                        <DataGrid.RowStyle>
                            <Style TargetType="DataGridRow">
                                <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}"/>
                                <Setter Property="ToolTip">
                                    <Setter.Value>
                                        <ToolTip MaxWidth="560">
                                            <StackPanel>
                                                <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextWrapping="Wrap"/>
                                                <TextBlock Text="{Binding FullSummary}" TextWrapping="Wrap" Margin="0,6,0,0"/>
                                            </StackPanel>
                                        </ToolTip>
                                    </Setter.Value>
                                </Setter>
                                <Style.Triggers>
                                    <Trigger Property="IsSelected" Value="True">
                                        <Setter Property="Background" Value="{DynamicResource SelectionBgBrush}"/>
                                        <Setter Property="Foreground" Value="{DynamicResource SelectionFgBrush}"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </DataGrid.RowStyle>
                    </DataGrid>
                    <Border x:Name="EmptyState" Background="{DynamicResource EmptyStateBgBrush}" Visibility="Collapsed">
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Margin="24,20">
                            <TextBlock Text="&#x1F916;" FontSize="36" HorizontalAlignment="Center"
                                       Foreground="{DynamicResource EmptyIconBrush}" FontFamily="Segoe UI Emoji"/>
                            <TextBlock Text="还没有自动化规则" FontSize="15" FontWeight="SemiBold"
                                       HorizontalAlignment="Center" Margin="0,10,0,6"
                                       Foreground="{DynamicResource EmptyTitleBrush}"/>
                            <TextBlock Text="点「从模板新建」按场景生成，或「新建」手动配置。新规则默认只记录，不会真正改网卡。" FontSize="12"
                                       Foreground="{DynamicResource MutedTextBrush}" TextWrapping="Wrap"
                                       TextAlignment="Center" MaxWidth="400" LineHeight="20"/>
                        </StackPanel>
                    </Border>
                </Grid>
            </DockPanel>

            <GridSplitter Grid.Row="1" Height="6" HorizontalAlignment="Stretch"
                          VerticalAlignment="Center" Background="{DynamicResource SeparatorBrush}"/>

            <DockPanel Grid.Row="2" Margin="0,4,0,0">
                <DockPanel DockPanel.Dock="Top" Margin="0,0,0,6">
                    <TextBlock Style="{StaticResource SectionLabel}" Text="运行日志"/>
                    <Button DockPanel.Dock="Right" HorizontalAlignment="Right" Content="清空"
                            Padding="10,3" MinWidth="64" Click="BtnClearLog_Click"
                            ToolTip="完整审计日志（JSONL）在 %LocalAppData%\WinNetManager\audit"/>
                </DockPanel>
                <ListBox x:Name="LogList" Background="{DynamicResource PanelBgBrush}"
                         BorderBrush="{DynamicResource BorderLineBrush}"
                         HorizontalContentAlignment="Stretch"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         ScrollViewer.VerticalScrollBarVisibility="Auto">
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                            <Setter Property="Padding" Value="8,5"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Severity}" Value="2">
                                    <Setter Property="Foreground" Value="{DynamicResource DangerBrush}"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding Severity}" Value="1">
                                    <Setter Property="Foreground" Value="{DynamicResource WarningTextBrush}"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </ListBox.ItemContainerStyle>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="58"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="{Binding Timestamp, StringFormat='{}{0:HH:mm:ss}'}"
                                           FontFamily="Consolas" FontSize="11"
                                           Foreground="{DynamicResource MutedTextBrush}"
                                           VerticalAlignment="Top"/>
                                <TextBlock Grid.Column="1" Text="{Binding Tag}" Margin="0,0,10,0"
                                           FontSize="11" FontWeight="SemiBold"
                                           Foreground="{DynamicResource SecondaryTextBrush}"
                                           VerticalAlignment="Top"/>
                                <TextBlock Grid.Column="2" Text="{Binding Message}" FontSize="12"
                                           TextWrapping="Wrap" VerticalAlignment="Top"/>
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>
        </Grid>
    </DockPanel>
</UserControl>
