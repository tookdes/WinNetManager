<Window x:Class="WinNetManager.Views.RuleEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="编辑自动化规则" Height="740" Width="920"
        MinHeight="620" MinWidth="780"
        WindowStartupLocation="CenterOwner" ResizeMode="CanResizeWithGrip"
        ShowInTaskbar="False" Icon="../netfol.ico"
        Background="{DynamicResource WindowBgBrush}">
    <Window.Resources>
        <Style x:Key="EditorLabel" TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,0,8,0"/>
            <Setter Property="Foreground" Value="{DynamicResource SecondaryTextBrush}"/>
        </Style>
        <Style x:Key="SectionHint" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Foreground" Value="{DynamicResource SecondaryTextBrush}"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource PanelBgBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderLineBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="3"/>
            <Setter Property="Padding" Value="12,10"/>
        </Style>
        <Style x:Key="ItemCard" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource WindowBgBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderLineBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="3"/>
            <Setter Property="Padding" Value="10,8"/>
            <Setter Property="Margin" Value="0,0,0,8"/>
        </Style>
        <Style x:Key="EditorList" TargetType="ListBox">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled"/>
            <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Auto"/>
        </Style>
        <Style x:Key="EditorListItem" TargetType="ListBoxItem">
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Margin" Value="0"/>
        </Style>
    </Window.Resources>

    <DockPanel Margin="14">
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Content="保存" Padding="18,6" MinWidth="88" FontWeight="SemiBold" IsDefault="True" Click="BtnSave_Click"/>
            <Button Content="取消" Padding="18,6" MinWidth="80" Margin="8,0,0,0" IsCancel="True" Click="BtnCancel_Click"/>
        </StackPanel>

        <Border DockPanel.Dock="Top" Style="{StaticResource Card}" Margin="0,0,0,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Style="{StaticResource EditorLabel}" Text="名称"/>
                <TextBox x:Name="TxtName" Grid.Column="1" Padding="6,4" VerticalAlignment="Center"/>
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="14,0,0,0">
                    <CheckBox x:Name="ChkEnabled" Content="启用" VerticalAlignment="Center" Margin="0,0,14,0"/>
                    <CheckBox x:Name="ChkDryRun" Content="只记录，不执行" VerticalAlignment="Center" Margin="0,0,14,0"
                              ToolTip="影子模式：只评估与记录，不执行任何动作。新规则默认开启"/>
                    <Button x:Name="BtnTemplate" Content="从模板填充…" Padding="10,4" Click="BtnTemplate_Click"/>
                </StackPanel>
            </Grid>
        </Border>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="8"/>
                <RowDefinition Height="*" MinHeight="160"/>
                <RowDefinition Height="8"/>
                <RowDefinition Height="*" MinHeight="180"/>
            </Grid.RowDefinitions>

            <Border Grid.Row="0" Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Text="触发门槛" FontWeight="SemiBold" Margin="0,0,0,8"/>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" MinWidth="88"/>
                            <ColumnDefinition Width="*" MinWidth="72"/>
                            <ColumnDefinition Width="12"/>
                            <ColumnDefinition Width="Auto" MinWidth="88"/>
                            <ColumnDefinition Width="*" MinWidth="72"/>
                            <ColumnDefinition Width="12"/>
                            <ColumnDefinition Width="Auto" MinWidth="96"/>
                            <ColumnDefinition Width="*" MinWidth="72"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="8"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="8"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <TextBlock Style="{StaticResource EditorLabel}" Text="间隔（分）"/>
                        <TextBox x:Name="TxtInterval" Grid.Column="1" Padding="6,3" ToolTip="每隔多久评估一次"/>
                        <TextBlock Grid.Column="3" Style="{StaticResource EditorLabel}" Text="连续次数"/>
                        <TextBox x:Name="TxtConsecutive" Grid.Column="4" Padding="6,3"/>
                        <TextBlock Grid.Column="6" Style="{StaticResource EditorLabel}" Text="持续（秒）"/>
                        <TextBox x:Name="TxtSustain" Grid.Column="7" Padding="6,3"/>

                        <TextBlock Grid.Row="2" Style="{StaticResource EditorLabel}" Text="滑窗大小"/>
                        <TextBox x:Name="TxtWindowSize" Grid.Row="2" Grid.Column="1" Padding="6,3"
                                 ToolTip="0=不使用滑窗；例如 5 表示最近 5 次评估"/>
                        <TextBlock Grid.Row="2" Grid.Column="3" Style="{StaticResource EditorLabel}" Text="滑窗至少"/>
                        <TextBox x:Name="TxtWindowMin" Grid.Row="2" Grid.Column="4" Padding="6,3"/>
                        <TextBlock Grid.Row="2" Grid.Column="6" Style="{StaticResource EditorLabel}" Text="冷却（秒）"/>
                        <TextBox x:Name="TxtCooldown" Grid.Row="2" Grid.Column="7" Padding="6,3"/>

                        <TextBlock Grid.Row="4" Style="{StaticResource EditorLabel}" Text="动作前延迟"/>
                        <TextBox x:Name="TxtPreDelay" Grid.Row="4" Grid.Column="1" Padding="6,3"
                                 ToolTip="触发后等待多久再执行动作"/>
                        <TextBlock Grid.Row="4" Grid.Column="3" Style="{StaticResource EditorLabel}" Text="预算/小时"/>
                        <TextBox x:Name="TxtBudgetHour" Grid.Row="4" Grid.Column="4" Padding="6,3"/>
                        <TextBlock Grid.Row="4" Grid.Column="6" Style="{StaticResource EditorLabel}" Text="预算/天"/>
                        <TextBox x:Name="TxtBudgetDay" Grid.Row="4" Grid.Column="7" Padding="6,3"/>
                    </Grid>
                </StackPanel>
            </Border>

            <Border Grid.Row="2" Style="{StaticResource Card}">
                <DockPanel>
                    <Grid DockPanel.Dock="Top" Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="条件" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,12,0"/>
                            <TextBlock Style="{StaticResource EditorLabel}" Text="组合"/>
                            <ComboBox x:Name="CmbConditionOperator" Width="148" VerticalContentAlignment="Center">
                                <ComboBoxItem Content="全部满足（AND）" Tag="And" IsSelected="True"/>
                                <ComboBoxItem Content="任一满足（OR）" Tag="Or"/>
                            </ComboBox>
                        </StackPanel>
                        <TextBlock Grid.Column="1" Style="{StaticResource SectionHint}" Margin="14,0,12,0"
                                   Text="未知结果不累计也不清零。"/>
                        <StackPanel Grid.Column="2" Orientation="Horizontal">
                            <Button Content="添加条件" Padding="10,4" Click="BtnAddCondition_Click"/>
                            <Button Content="移除选中" Padding="10,4" Margin="6,0,0,0" Click="BtnRemoveCondition_Click"/>
                        </StackPanel>
                    </Grid>
                    <ListBox x:Name="ConditionList" Style="{StaticResource EditorList}"
                             ItemContainerStyle="{StaticResource EditorListItem}">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Border Style="{StaticResource ItemCard}">
                                    <StackPanel>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="56"/>
                                                <ColumnDefinition Width="*" MinWidth="140"/>
                                                <ColumnDefinition Width="12"/>
                                                <ColumnDefinition Width="56"/>
                                                <ColumnDefinition Width="*" MinWidth="120"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Style="{StaticResource EditorLabel}" Text="类型"/>
                                            <ComboBox Grid.Column="1" SelectedValuePath="Tag" SelectedValue="{Binding Type}">
                                                <ComboBoxItem Content="IPv6 ping 失败" Tag="pingFail"/>
                                                <ComboBoxItem Content="IPv4 ping 失败" Tag="pingFailV4"/>
                                                <ComboBoxItem Content="IPv6 ping 成功" Tag="pingOk"/>
                                                <ComboBoxItem Content="IPv4 ping 成功" Tag="pingOkV4"/>
                                                <ComboBoxItem Content="网卡 Up" Tag="adapterUp"/>
                                                <ComboBoxItem Content="网卡有全局地址" Tag="hasAddr"/>
                                                <ComboBoxItem Content="存在配置文件" Tag="profileExists"/>
                                                <ComboBoxItem Content="新配置晚于旧配置" Tag="profileAfter"/>
                                            </ComboBox>
                                            <TextBlock Grid.Column="3" Text="网卡">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock" BasedOn="{StaticResource EditorLabel}">
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding Type}" Value="profileExists">
                                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding Type}" Value="profileAfter">
                                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                            <ComboBox Grid.Column="4" SelectedValuePath="Id" SelectedValue="{Binding AdapterId}"
                                                      ItemsSource="{Binding Adapters, RelativeSource={RelativeSource AncestorType=Window}}"
                                                      DisplayMemberPath="Name">
                                                <ComboBox.Style>
                                                    <Style TargetType="ComboBox" BasedOn="{StaticResource {x:Type ComboBox}}">
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding Type}" Value="profileExists">
                                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding Type}" Value="profileAfter">
                                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </ComboBox.Style>
                                            </ComboBox>
                                        </Grid>

                                        <Grid Margin="0,8,0,0">
                                            <Grid.Style>
                                                <Style TargetType="Grid">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Type}" Value="pingFail"><Setter Property="Visibility" Value="Visible"/></DataTrigger>
                                                        <DataTrigger Binding="{Binding Type}" Value="pingFailV4"><Setter Property="Visibility" Value="Visible"/></DataTrigger>
                                                        <DataTrigger Binding="{Binding Type}" Value="pingOk"><Setter Property="Visibility" Value="Visible"/></DataTrigger>
                                                        <DataTrigger Binding="{Binding Type}" Value="pingOkV4"><Setter Property="Visibility" Value="Visible"/></DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Grid.Style>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="56"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="12"/>
                                                <ColumnDefinition Width="56"/>
                                                <ColumnDefinition Width="90"/>
                                                <ColumnDefinition Width="12"/>
                                                <ColumnDefinition Width="72"/>
                                                <ColumnDefinition Width="80"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Style="{StaticResource EditorLabel}" Text="目标"/>
                                            <TextBox Grid.Column="1" Text="{Binding Targets, UpdateSourceTrigger=PropertyChanged}" Padding="6,3"
                                                     ToolTip="多个目标用逗号分隔"/>
                                            <TextBlock Grid.Column="3" Style="{StaticResource EditorLabel}" Text="模式"/>
                                            <ComboBox Grid.Column="4" SelectedValuePath="Tag" SelectedValue="{Binding Mode}">
                                                <ComboBoxItem Content="全部" Tag="All"/>
                                                <ComboBoxItem Content="任一" Tag="Any"/>
                                            </ComboBox>
                                            <TextBlock Grid.Column="6" Style="{StaticResource EditorLabel}" Text="超时 ms"/>
                                            <TextBox Grid.Column="7" Text="{Binding TimeoutMs, UpdateSourceTrigger=PropertyChanged}" Padding="6,3"/>
                                        </Grid>

                                        <Grid Margin="0,8,0,0">
                                            <Grid.Style>
                                                <Style TargetType="Grid">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Type}" Value="hasAddr"><Setter Property="Visibility" Value="Visible"/></DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Grid.Style>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="56"/>
                                                <ColumnDefinition Width="120"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Style="{StaticResource EditorLabel}" Text="地址族"/>
                                            <ComboBox Grid.Column="1" SelectedValuePath="Tag" SelectedValue="{Binding Family}">
                                                <ComboBoxItem Content="IPv4" Tag="IPv4"/>
                                                <ComboBoxItem Content="IPv6" Tag="IPv6"/>
                                            </ComboBox>
                                        </Grid>

                                        <Grid Margin="0,8,0,0">
                                            <Grid.Style>
                                                <Style TargetType="Grid">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Type}" Value="profileExists"><Setter Property="Visibility" Value="Visible"/></DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Grid.Style>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="56"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Style="{StaticResource EditorLabel}" Text="名称"/>
                                            <TextBox Grid.Column="1" Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" Padding="6,3"/>
                                        </Grid>

                                        <Grid Margin="0,8,0,0">
                                            <Grid.Style>
                                                <Style TargetType="Grid">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Type}" Value="profileAfter"><Setter Property="Visibility" Value="Visible"/></DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Grid.Style>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="56"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="12"/>
                                                <ColumnDefinition Width="56"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Style="{StaticResource EditorLabel}" Text="新名称"/>
                                            <TextBox Grid.Column="1" Text="{Binding NewerName, UpdateSourceTrigger=PropertyChanged}" Padding="6,3"/>
                                            <TextBlock Grid.Column="3" Style="{StaticResource EditorLabel}" Text="旧名称"/>
                                            <TextBox Grid.Column="4" Text="{Binding OlderName, UpdateSourceTrigger=PropertyChanged}" Padding="6,3"/>
                                        </Grid>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>
            </Border>

            <Border Grid.Row="4" Style="{StaticResource Card}">
                <DockPanel>
                    <Grid DockPanel.Dock="Top" Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="动作" FontWeight="SemiBold" VerticalAlignment="Center"/>
                        <TextBlock Grid.Column="1" Style="{StaticResource SectionHint}" Margin="12,0,12,0"
                                   Text="按从上到下顺序执行。可用「失败时 / 执行时机」控制分支。"/>
                        <StackPanel Grid.Column="2" Orientation="Horizontal">
                            <Button Content="添加动作" Padding="10,4" Click="BtnAddAction_Click"/>
                            <Button Content="移除" Padding="10,4" Margin="6,0,0,0" Click="BtnRemoveAction_Click"/>
                            <Button Content="上移" Padding="10,4" Margin="6,0,0,0" Click="BtnMoveActionUp_Click"/>
                            <Button Content="下移" Padding="10,4" Margin="6,0,0,0" Click="BtnMoveActionDown_Click"/>
                        </StackPanel>
                    </Grid>
                    <ListBox x:Name="ActionList" Style="{StaticResource EditorList}"
                             ItemContainerStyle="{StaticResource EditorListItem}">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Border Style="{StaticResource ItemCard}">
                                    <StackPanel>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="56"/>
                                                <ColumnDefinition Width="1.2*" MinWidth="140"/>
                                                <ColumnDefinition Width="12"/>
                                                <ColumnDefinition Width="56"/>
                                                <ColumnDefinition Width="86"/>
                                                <ColumnDefinition Width="12"/>
                                                <ColumnDefinition Width="56"/>
                                                <ColumnDefinition Width="*" MinWidth="140"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Style="{StaticResource EditorLabel}" Text="类型"/>
                                            <ComboBox Grid.Column="1" SelectedValuePath="Tag" SelectedValue="{Binding Type}">
                                                <ComboBoxItem Content="Renew（软刷新）" Tag="renew"/>
                                                <ComboBoxItem Content="重启网卡" Tag="restart"/>
                                                <ComboBoxItem Content="HTTP 请求" Tag="http"/>
                                                <ComboBoxItem Content="通知" Tag="notify"/>
                                                <ComboBoxItem Content="等待" Tag="wait"/>
                                                <ComboBoxItem Content="等待网卡恢复地址" Tag="waitUntil"/>
                                                <ComboBoxItem Content="删除配置文件" Tag="deleteProfile"/>
                                                <ComboBoxItem Content="重命名配置文件" Tag="renameProfile"/>
                                                <ComboBoxItem Content="合并配置文件" Tag="merge"/>
                                            </ComboBox>
                                            <TextBlock Grid.Column="3" Style="{StaticResource EditorLabel}" Text="失败时"/>
                                            <ComboBox Grid.Column="4" SelectedValuePath="Tag" SelectedValue="{Binding OnFailure}">
                                                <ComboBoxItem Content="继续" Tag="Continue"/>
                                                <ComboBoxItem Content="中止" Tag="Stop"/>
                                            </ComboBox>
                                            <TextBlock Grid.Column="6" Style="{StaticResource EditorLabel}" Text="时机"/>
                                            <ComboBox Grid.Column="7" SelectedValuePath="Tag" SelectedValue="{Binding RunWhen}">
                                                <ComboBoxItem Content="总是" Tag="Always"/>
                                                <ComboBoxItem Content="仅前一步失败" Tag="OnlyOnPreviousFailure"/>
                                                <ComboBoxItem Content="仅前一步成功" Tag="OnlyOnPreviousSuccess"/>
                                            </ComboBox>
                                        </Grid>

                                        <Grid Margin="0,8,0,0">
                                            <Grid.Style>
                                                <Style TargetType="Grid">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Type}" Value="renew"><Setter Property="Visibility" Value="Visible"/></DataTrigger>
                                                        <DataTrigger Binding="{Binding Type}" Value="restart"><Setter Property="Visibility" Value="Visible"/></DataTrigger>
                                                        <DataTrigger Binding="{Binding Type}" Value="waitUntil"><Setter Property="Visibility" Value="Visible"/></DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Grid.Style>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="56"/>
                                                <ColumnDefinition Width="*" MinWidth="140"/>
                                                <ColumnDefinition Width="12"/>
                                                <ColumnDefinition Width="56"/>
                                                <ColumnDefinition Width="90"/>
                                                <ColumnDefinition Width="12"/>
                                                <ColumnDefinition Width="72"/>
                                                <ColumnDefinition Width="80"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Style="{StaticResource EditorLabel}" Text="网卡"/>
                                            <ComboBox Grid.Column="1" SelectedValuePath="Id" SelectedValue="{Binding AdapterId}"
                                                      ItemsSource="{Binding Adapters, RelativeSource={RelativeSource AncestorType=Window}}"
                                                      DisplayMemberPath="Name"/>
                                            <TextBlock Grid.Column="3" Text="地址族">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock" BasedOn="{StaticResource EditorLabel}">
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding Type}" Value="restart">
                                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                            <ComboBox Grid.Column="4" SelectedValuePath="Tag" SelectedValue="{Binding Family}">
                                                <ComboBox.Style>
                                                    <Style TargetType="ComboBox" BasedOn="{StaticResource {x:Type ComboBox}}">
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding Type}" Value="restart">
                                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </ComboBox.Style>
                                                <ComboBoxItem Content="IPv4" Tag="IPv4"/>
                                                <ComboBoxItem Content="IPv6" Tag="IPv6"/>
                                            </ComboBox>
                                            <TextBlock Grid.Column="6" Text="超时秒">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock" BasedOn="{StaticResource EditorLabel}">
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding Type}" Value="waitUntil">
                                                                <Setter Property="Visibility" Value="Visible"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                            <TextBox Grid.Column="7" Text="{Binding TimeoutSeconds, UpdateSourceTrigger=PropertyChanged}" Padding="6,3">
                                                <TextBox.Style>
                                                    <Style TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding Type}" Value="waitUntil">
                                                                <Setter Property="Visibility" Value="Visible"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBox.Style>
                                            </TextBox>
                                        </Grid>

                                        <Grid Margin="0,8,0,0">
                                            <Grid.Style>
                                                <Style TargetType="Grid">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Type}" Value="http"><Setter Property="Visibility" Value="Visible"/></DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Grid.Style>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="8"/>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="8"/>
                                                <RowDefinition Height="Auto"/>
                                            </Grid.RowDefinitions>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="56"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="12"/>
                                                <ColumnDefinition Width="56"/>
                                                <ColumnDefinition Width="90"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Style="{StaticResource EditorLabel}" Text="URL"/>
                                            <TextBox Grid.Column="1" Text="{Binding Url, UpdateSourceTrigger=PropertyChanged}" Padding="6,3"/>
                                            <TextBlock Grid.Column="3" Style="{StaticResource EditorLabel}" Text="方法"/>
                                            <ComboBox Grid.Column="4" SelectedValuePath="Tag" SelectedValue="{Binding Method}">
                                                <ComboBoxItem Content="GET" Tag="GET"/>
                                                <ComboBoxItem Content="POST" Tag="POST"/>
                                                <ComboBoxItem Content="HEAD" Tag="HEAD"/>
                                            </ComboBox>
                                            <TextBlock Grid.Row="2" Style="{StaticResource EditorLabel}" Text="出口"/>
                                            <ComboBox Grid.Row="2" Grid.Column="1" SelectedValuePath="Id" SelectedValue="{Binding ViaAdapterId}"
                                                      ItemsSource="{Binding ViaAdapters, RelativeSource={RelativeSource AncestorType=Window}}"
                                                      DisplayMemberPath="Name"
                                                      ToolTip="可空：留空走系统默认路由"/>
                                            <TextBlock Grid.Row="2" Grid.Column="3" Style="{StaticResource EditorLabel}" Text="出口族"/>
                                            <ComboBox Grid.Row="2" Grid.Column="4" SelectedValuePath="Tag" SelectedValue="{Binding ViaFamily}">
                                                <ComboBoxItem Content="IPv4" Tag="IPv4"/>
                                                <ComboBoxItem Content="IPv6" Tag="IPv6"/>
                                            </ComboBox>
                                            <Grid Grid.Row="4" Grid.Column="0" Grid.ColumnSpan="5">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="56"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="12"/>
                                                    <ColumnDefinition Width="56"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="12"/>
                                                    <ColumnDefinition Width="72"/>
                                                    <ColumnDefinition Width="80"/>
                                                    <ColumnDefinition Width="12"/>
                                                    <ColumnDefinition Width="56"/>
                                                    <ColumnDefinition Width="70"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Style="{StaticResource EditorLabel}" Text="SOCKS5"/>
                                                <TextBox Grid.Column="1" Text="{Binding SocksProxy, UpdateSourceTrigger=PropertyChanged}" Padding="6,3"
                                                         ToolTip="host:port 或 user:pass@host:port"/>
                                                <TextBlock Grid.Column="3" Style="{StaticResource EditorLabel}" Text="域名"/>
                                                <TextBox Grid.Column="4" Text="{Binding ResolveHost, UpdateSourceTrigger=PropertyChanged}" Padding="6,3"
                                                         ToolTip="--resolve 域名"/>
                                                <TextBlock Grid.Column="6" Style="{StaticResource EditorLabel}" Text="固定 IP"/>
                                                <TextBox Grid.Column="7" Text="{Binding ResolveIp, UpdateSourceTrigger=PropertyChanged}" Padding="6,3"/>
                                                <TextBlock Grid.Column="9" Style="{StaticResource EditorLabel}" Text="状态码"/>
                                                <TextBox Grid.Column="10" Text="{Binding ExpectedStatus, UpdateSourceTrigger=PropertyChanged}" Padding="6,3"
                                                         ToolTip="期望 HTTP 状态码，可空"/>
                                            </Grid>
                                        </Grid>

                                        <Grid Margin="0,8,0,0">
                                            <Grid.Style>
                                                <Style TargetType="Grid">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Type}" Value="http"><Setter Property="Visibility" Value="Visible"/></DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Grid.Style>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="56"/>
                                                <ColumnDefinition Width="90"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Style="{StaticResource EditorLabel}" Text="超时 ms"/>
                                            <TextBox Grid.Column="1" Text="{Binding TimeoutMs, UpdateSourceTrigger=PropertyChanged}" Padding="6,3"/>
                                        </Grid>

                                        <Grid Margin="0,8,0,0">
                                            <Grid.Style>
                                                <Style TargetType="Grid">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Type}" Value="notify"><Setter Property="Visibility" Value="Visible"/></DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Grid.Style>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="56"/>
                                                <ColumnDefinition Width="160"/>
                                                <ColumnDefinition Width="12"/>
                                                <ColumnDefinition Width="40"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="12"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Style="{StaticResource EditorLabel}" Text="标题"/>
                                            <TextBox Grid.Column="1" Text="{Binding Title, UpdateSourceTrigger=PropertyChanged}" Padding="6,3"/>
                                            <TextBlock Grid.Column="3" Style="{StaticResource EditorLabel}" Text="内容"/>
                                            <TextBox Grid.Column="4" Text="{Binding Message, UpdateSourceTrigger=PropertyChanged}" Padding="6,3"/>
                                            <CheckBox Grid.Column="6" Content="弹窗" IsChecked="{Binding Popup}" VerticalAlignment="Center"/>
                                        </Grid>

                                        <Grid Margin="0,8,0,0">
                                            <Grid.Style>
                                                <Style TargetType="Grid">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Type}" Value="wait"><Setter Property="Visibility" Value="Visible"/></DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Grid.Style>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="56"/>
                                                <ColumnDefinition Width="90"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Style="{StaticResource EditorLabel}" Text="秒数"/>
                                            <TextBox Grid.Column="1" Text="{Binding Seconds, UpdateSourceTrigger=PropertyChanged}" Padding="6,3"/>
                                        </Grid>

                                        <Grid Margin="0,8,0,0">
                                            <Grid.Style>
                                                <Style TargetType="Grid">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Type}" Value="deleteProfile"><Setter Property="Visibility" Value="Visible"/></DataTrigger>
                                                        <DataTrigger Binding="{Binding Type}" Value="renameProfile"><Setter Property="Visibility" Value="Visible"/></DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Grid.Style>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="56"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="12"/>
                                                <ColumnDefinition Width="56"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Style="{StaticResource EditorLabel}" Text="名称"/>
                                            <TextBox Grid.Column="1" Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" Padding="6,3"/>
                                            <TextBlock Grid.Column="3" Text="新名称">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock" BasedOn="{StaticResource EditorLabel}">
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding Type}" Value="renameProfile">
                                                                <Setter Property="Visibility" Value="Visible"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                            <TextBox Grid.Column="4" Text="{Binding ToName, UpdateSourceTrigger=PropertyChanged}" Padding="6,3">
                                                <TextBox.Style>
                                                    <Style TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding Type}" Value="renameProfile">
                                                                <Setter Property="Visibility" Value="Visible"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBox.Style>
                                            </TextBox>
                                        </Grid>

                                        <Grid Margin="0,8,0,0">
                                            <Grid.Style>
                                                <Style TargetType="Grid">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Type}" Value="merge"><Setter Property="Visibility" Value="Visible"/></DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Grid.Style>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="56"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="12"/>
                                                <ColumnDefinition Width="56"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Style="{StaticResource EditorLabel}" Text="保留名"/>
                                            <TextBox Grid.Column="1" Text="{Binding KeepName, UpdateSourceTrigger=PropertyChanged}" Padding="6,3"/>
                                            <TextBlock Grid.Column="3" Style="{StaticResource EditorLabel}" Text="重复名"/>
                                            <TextBox Grid.Column="4" Text="{Binding DuplicateName, UpdateSourceTrigger=PropertyChanged}" Padding="6,3"/>
                                        </Grid>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>
            </Border>
        </Grid>
    </DockPanel>
</Window>
