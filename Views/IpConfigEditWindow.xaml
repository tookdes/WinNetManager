<Window x:Class="WinNetManager.Views.IpConfigEditWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="设为静态 IP" Height="320" Width="420"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Icon="../netfol.ico">
    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Label Grid.Row="0" Grid.Column="0" Content="网卡：" VerticalAlignment="Center"/>
        <TextBox Grid.Row="0" Grid.Column="1" x:Name="TxtAdapter" Margin="5" IsReadOnly="True"
                 Background="{DynamicResource ReadOnlyBgBrush}"/>

        <Label Grid.Row="1" Grid.Column="0" Content="IPv4 地址：" VerticalAlignment="Center"/>
        <TextBox Grid.Row="1" Grid.Column="1" x:Name="TxtIp" Margin="5"
                 ToolTip="例如 192.168.1.100"/>

        <Label Grid.Row="2" Grid.Column="0" Content="前缀长度：" VerticalAlignment="Center"/>
        <TextBox Grid.Row="2" Grid.Column="1" x:Name="TxtPrefix" Margin="5"
                 ToolTip="CIDR 前缀，24 = 255.255.255.0，16 = 255.255.0.0"/>

        <Label Grid.Row="3" Grid.Column="0" Content="默认网关：" VerticalAlignment="Center"/>
        <TextBox Grid.Row="3" Grid.Column="1" x:Name="TxtGateway" Margin="5"
                 ToolTip="可留空。例如 192.168.1.1"/>

        <TextBlock Grid.Row="4" Grid.Column="0" Grid.ColumnSpan="2"
                   Foreground="{DynamicResource SecondaryTextBrush}" FontSize="11" Margin="5,10,5,0"
                   TextWrapping="Wrap" VerticalAlignment="Top"
                   Text="将禁用该网卡的 IPv4 DHCP，并替换现有 IPv4 地址/默认网关。DNS 请到「DNS」标签页单独配置。远程操作有断连风险，请确认新配置可达。"/>

        <StackPanel Grid.Row="5" Grid.Column="0" Grid.ColumnSpan="2"
                    Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Content="应用" Width="80" Margin="5" IsDefault="True" Click="BtnSave_Click"/>
            <Button Content="取消" Width="80" Margin="5" IsCancel="True"/>
        </StackPanel>
    </Grid>
</Window>
