<UserControl x:Class="WinNetManager.Views.FirewallTab"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <DockPanel Margin="8">
        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,8">
            <Button Content="刷新" Padding="12,4" Click="BtnRefresh_Click"/>
            <Button Content="全选" Padding="8,4" Margin="6,0,0,0" Click="BtnSelectAll_Click"/>
            <Button Content="反选" Padding="8,4" Margin="4,0,0,0" Click="BtnInvertSelection_Click"/>
            <Rectangle Width="1" Fill="{DynamicResource SeparatorBrush}" Margin="10,2"/>
            <Button Content="新建" Padding="12,4" Margin="6,0,0,0" Click="BtnNew_Click"/>
            <Button Content="修改" Padding="12,4" Margin="6,0,0,0" Click="BtnEdit_Click"/>
            <Button Content="删除" Padding="12,4" Margin="6,0,0,0" Foreground="{DynamicResource DangerBrush}" Click="BtnDelete_Click"/>
            <Rectangle Width="1" Fill="{DynamicResource SeparatorBrush}" Margin="10,2"/>
            <Button Content="启用" Padding="12,4" Margin="6,0,0,0" Click="BtnEnable_Click"/>
            <Button Content="禁用" Padding="12,4" Margin="6,0,0,0" Click="BtnDisable_Click"/>
            <Rectangle Width="1" Fill="{DynamicResource SeparatorBrush}" Margin="10,2"/>
            <CheckBox x:Name="ChkOwnOnly" Content="仅本工具创建" Margin="6,0,0,0" VerticalAlignment="Center" IsChecked="True" Checked="ChkOwnOnly_Changed" Unchecked="ChkOwnOnly_Changed"/>
            <TextBox x:Name="TxtFilter" Width="100" Margin="8,0,0,0" Padding="4,2"
                     TextChanged="TxtFilter_TextChanged" Tag="Filter" ToolTip="筛选名称、端口、网卡"/>
            <Button Content="清除" Padding="8,4" Margin="4,0,0,0" Click="BtnClearFilter_Click"/>
        </StackPanel>
        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,6">
            <TextBlock DockPanel.Dock="Left" FontSize="11" Foreground="{DynamicResource SecondaryTextBrush}"
                       Text="管理 Windows Defender 防火墙入站规则。可绑定网卡，默认对全部配置文件生效，不限本地子网。"/>
            <TextBlock x:Name="TbkCount" DockPanel.Dock="Right" FontSize="11" Foreground="{DynamicResource SecondaryTextBrush}" HorizontalAlignment="Right"/>
        </DockPanel>
        <Grid>
            <DataGrid x:Name="RuleGrid" AutoGenerateColumns="False" CanUserAddRows="False"
                      IsReadOnly="True" SelectionMode="Extended" GridLinesVisibility="Horizontal"
                      HeadersVisibility="Column" ColumnWidth="Auto" Sorting="Grid_Sorting">
                <DataGrid.ContextMenu>
                    <ContextMenu>
                        <MenuItem Header="新建" Click="BtnNew_Click"/>
                        <MenuItem Header="修改" Click="BtnEdit_Click"/>
                        <Separator/>
                        <MenuItem Header="启用" Click="BtnEnable_Click"/>
                        <MenuItem Header="禁用" Click="BtnDisable_Click"/>
                        <Separator/>
                        <MenuItem Header="删除" Click="BtnDelete_Click" Foreground="{DynamicResource DangerBrush}"/>
                        <Separator/>
                        <MenuItem Header="复制选中值" Click="MenuCopy_Click"/>
                    </ContextMenu>
                </DataGrid.ContextMenu>
                <DataGrid.Columns>
                    <DataGridTextColumn Binding="{Binding DisplayName}" Width="220">
                        <DataGridTextColumn.Header>
                            <TextBlock Text="显示名称"/>
                        </DataGridTextColumn.Header>
                    </DataGridTextColumn>
                    <DataGridTextColumn Binding="{Binding Direction}" Width="Auto" Header="方向"/>
                    <DataGridTextColumn Binding="{Binding Action}" Width="Auto" Header="动作"/>
                    <DataGridTextColumn Binding="{Binding EnabledDisplay}" Width="Auto" Header="启用"/>
                    <DataGridTextColumn Binding="{Binding Protocol}" Width="Auto" Header="协议"/>
                    <DataGridTextColumn Binding="{Binding LocalPort}" Width="Auto" Header="本地端口"/>
                    <DataGridTextColumn Binding="{Binding Profile}" Width="Auto" Header="配置文件"/>
                    <DataGridTextColumn Binding="{Binding InterfaceAlias}" Width="Auto" Header="绑定网卡"/>
                    <DataGridTextColumn Binding="{Binding LocalAddress}" Width="Auto" Header="本地地址"/>
                </DataGrid.Columns>
            </DataGrid>
            <Border x:Name="EmptyState" Background="{DynamicResource EmptyStateBgBrush}" Visibility="Collapsed">
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,50">
                    <TextBlock Text="&#x1F6E1;" FontSize="48" HorizontalAlignment="Center" Foreground="{DynamicResource EmptyIconBrush}" FontFamily="Segoe UI Emoji"/>
                    <TextBlock Text="暂无防火墙规则" FontSize="16" Foreground="{DynamicResource EmptyTitleBrush}" HorizontalAlignment="Center" Margin="0,12,0,4" FontWeight="SemiBold"/>
                    <TextBlock Text="默认只显示本工具创建的规则。取消「仅本工具创建」可加载全部入站规则。" FontSize="12" Foreground="{DynamicResource MutedTextBrush}" TextWrapping="Wrap" TextAlignment="Center" MaxWidth="460"/>
                    <Button Content="新建" Padding="16,4" Margin="0,16,0,0" HorizontalAlignment="Center" Click="BtnNew_Click"/>
                </StackPanel>
            </Border>
        </Grid>
    </DockPanel>
</UserControl>
