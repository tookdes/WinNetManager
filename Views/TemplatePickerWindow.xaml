<Window x:Class="WinNetManager.Views.TemplatePickerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="从模板创建规则" Height="560" Width="520"
        MinHeight="420" MinWidth="440"
        WindowStartupLocation="CenterOwner" ResizeMode="CanResizeWithGrip"
        ShowInTaskbar="False" Icon="../netfol.ico"
        Background="{DynamicResource WindowBgBrush}">
    <Window.Resources>
        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="Margin" Value="0,0,0,4"/>
            <Setter Property="Foreground" Value="{DynamicResource SecondaryTextBrush}"/>
        </Style>
        <Style x:Key="FieldBox" TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
            <Setter Property="Padding" Value="6,4"/>
            <Setter Property="Margin" Value="0,0,0,12"/>
        </Style>
        <Style x:Key="FieldCombo" TargetType="ComboBox" BasedOn="{StaticResource {x:Type ComboBox}}">
            <Setter Property="Margin" Value="0,0,0,12"/>
            <Setter Property="Padding" Value="6,4"/>
        </Style>
    </Window.Resources>

    <DockPanel Margin="16">
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button x:Name="BtnOk" Content="生成并编辑" Padding="16,6" MinWidth="104" FontWeight="SemiBold" IsDefault="True" Click="BtnOk_Click"/>
            <Button Content="取消" Padding="16,6" MinWidth="80" Margin="8,0,0,0" IsCancel="True" Click="BtnCancel_Click"/>
        </StackPanel>

        <TextBlock DockPanel.Dock="Top" Text="选择场景后填写对应网卡和目标。生成的规则默认只记录且未启用，可在下一步编辑器里再改。" FontSize="12"
                   Foreground="{DynamicResource SecondaryTextBrush}"
                   TextWrapping="Wrap" LineHeight="20" Margin="0,0,0,14"/>

        <TextBlock DockPanel.Dock="Top" Style="{StaticResource FieldLabel}" Text="场景模板"/>
        <ComboBox x:Name="CmbTemplate" DockPanel.Dock="Top" Style="{StaticResource FieldCombo}"
                  SelectionChanged="CmbTemplate_SelectionChanged">
            <ComboBoxItem Content="IPv6 自愈（软刷新）" Tag="ipv6soft"/>
            <ComboBoxItem Content="IPv6 自愈（重启保底）" Tag="ipv6restart"/>
            <ComboBoxItem Content="IPv4 掉线重启 + 经 B 通知" Tag="ipv4notify"/>
            <ComboBoxItem Content="A/B 全挂走 C / SOCKS5 兜底" Tag="fallback"/>
            <ComboBoxItem Content="网络配置文件整理" Tag="mergeprofile"/>
        </ComboBox>

        <Border DockPanel.Dock="Top" Margin="0,0,0,12" Padding="10,8"
                Background="{DynamicResource HeaderBgBrush}"
                BorderBrush="{DynamicResource BorderLineBrush}"
                BorderThickness="1" CornerRadius="3">
            <TextBlock x:Name="TbkHint" FontSize="11" TextWrapping="Wrap" LineHeight="18"
                       Foreground="{DynamicResource SecondaryTextBrush}"/>
        </Border>

        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel>
                <TextBlock x:Name="LblAdapterA" Style="{StaticResource FieldLabel}" Text="网卡 A（主线路）"/>
                <ComboBox x:Name="CmbAdapterA" Style="{StaticResource FieldCombo}"
                          DisplayMemberPath="Name" SelectedValuePath="Id"/>

                <TextBlock x:Name="LblAdapterB" Style="{StaticResource FieldLabel}" Text="网卡 B（第二线路）"/>
                <ComboBox x:Name="CmbAdapterB" Style="{StaticResource FieldCombo}"
                          DisplayMemberPath="Name" SelectedValuePath="Id"/>

                <TextBlock x:Name="LblAdapterC" Style="{StaticResource FieldLabel}" Text="网卡 C（4G 兜底）"/>
                <ComboBox x:Name="CmbAdapterC" Style="{StaticResource FieldCombo}"
                          DisplayMemberPath="Name" SelectedValuePath="Id"/>

                <TextBlock x:Name="LblTargetV6" Style="{StaticResource FieldLabel}" Text="IPv6 目标地址"/>
                <TextBox x:Name="TxtTargetV6" Style="{StaticResource FieldBox}" ToolTip="例如 2400:3200::1 或网关全局 IPv6 地址"/>

                <TextBlock x:Name="LblTargetV4A" Style="{StaticResource FieldLabel}" Text="IPv4 目标 A"/>
                <TextBox x:Name="TxtTargetV4A" Style="{StaticResource FieldBox}"/>

                <TextBlock x:Name="LblTargetV4B" Style="{StaticResource FieldLabel}" Text="IPv4 目标 B"/>
                <TextBox x:Name="TxtTargetV4B" Style="{StaticResource FieldBox}"/>

                <TextBlock x:Name="LblUrl" Style="{StaticResource FieldLabel}" Text="通知 URL（webhook）"/>
                <TextBox x:Name="TxtUrl" Style="{StaticResource FieldBox}"/>

                <TextBlock x:Name="LblSocks" Style="{StaticResource FieldLabel}" Text="SOCKS5 代理（host:port，可空）"/>
                <TextBox x:Name="TxtSocks" Style="{StaticResource FieldBox}"/>

                <StackPanel x:Name="PanelProfileNames">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="12"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock x:Name="LblProfileNames" Style="{StaticResource FieldLabel}" Text="保留的配置文件名"/>
                            <TextBox x:Name="TxtKeepName" Style="{StaticResource FieldBox}" ToolTip="例如：网络"/>
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Style="{StaticResource FieldLabel}" Text="重复的配置文件名"/>
                            <TextBox x:Name="TxtDupName" Style="{StaticResource FieldBox}" ToolTip="例如：网络 2"/>
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</Window>
